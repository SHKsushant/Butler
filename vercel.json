{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "server.py": {
      "includeFiles": "{frontend/**,backend/app/**}",
      "excludeFiles": "{backend/.venv/**,**/__pycache__/**,backend/tests/**,sample_data/**}",
      "maxDuration": 60
    }
  }
}